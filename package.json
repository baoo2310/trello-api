{
  "name": "trello-app",
  "type": "module",
  "version": "1.0.0",
  "main": "src/server.js",
  "repository": "https://github.com/baoo2310/trello-api",
  "author": "baoo2310",
  "license": "MIT",
  "scripts": {
    "test": "echo no test",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('build',{recursive:true,force:true});fs.mkdirSync('build',{recursive:true});\"",
    "build-babel": "babel ./src -d ./build/src",
    "build": "npm run clean && npm run build-babel",
    "production": "npm run build && node cross-env BUILD_MODE=prod ./build/src/server.js",
    "dev": "cross-env BUILD_MODE=dev nodemon --exec ./node_modules/.bin/babel-node ./src/server.js"
  },
  "dependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/node": "^7.29.0",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/runtime": "^7.28.6",
    "async-exit-hook": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.4",
    "env": "^0.0.2",
    "eslint": "^9.39.2",
    "express": "^5.2.1",
    "http-status-codes": "^2.3.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.23",
    "ms": "^2.1.3",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "nodemon": "^3.1.11",
    "pg": "^8.18.0",
    "streamifier": "^0.1.1",
    "uuid": "^13.0.0"
  }
}
